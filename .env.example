# Copy to .env and fill in. NEVER commit .env
JWT_SECRET=change-this-to-a-long-random-string-32chars-or-more
PORT=3000
BASE_PATH=/
TZ=Asia/Kolkata
NODE_ENV=production
# Students must type this code to register (give it at check-in). Leave empty to allow anyone.
REGISTER_CODE=
# Escalation: unanswered SOS goes to chief warden after 2 min, security/principal after 5 min
ESC1_SEC=120
ESC2_SEC=300
# Comma-separated phone numbers with country code. SMS sent via Twilio (optional).
WARDEN_PHONES=+91XXXXXXXXXX
CHIEF_PHONES=+91XXXXXXXXXX
SECURITY_PHONES=+91XXXXXXXXXX
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
